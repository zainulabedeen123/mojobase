{
  "name": "@mojobase/sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript client for Mojobase: Postgres database, auth, storage, edge functions, realtime and AI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.mjs",
      "require": "./dist/ssr.js"
    },
    "./ssr/middleware": {
      "types": "./dist/ssr/middleware.d.ts",
      "import": "./dist/ssr/middleware.mjs",
      "require": "./dist/ssr/middleware.js"
    }
  },
  "files": [
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SDK-REFERENCE.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc && tsc --module commonjs --outDir dist/cjs",
    "build:tsc-only": "tsc",
    "dev": "tsup --watch",
    "dev:tsc": "tsc --watch",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "keywords": [
    "mojobase",
    "baas",
    "backend",
    "postgres",
    "sdk",
    "typescript",
    "javascript",
    "client"
  ],
  "author": "Mojobase",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainulabedeen123/mojobase.git",
    "directory": "npm/sdk"
  },
  "homepage": "https://mojobase.dev/docs",
  "bugs": {
    "url": "https://github.com/zainulabedeen123/mojobase/issues"
  },
  "dependencies": {
    "@insforge/shared-schemas": "^1.2.1",
    "@supabase/postgrest-js": "^1.21.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^20.11.24",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^13.24.0",
    "prettier": "^3.6.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
